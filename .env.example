# ── Database (PostgreSQL) ─────────────────────────────────────────────
# Use a dedicated, non-superuser role that only owns this database.
DATABASE_URL=postgres://falah_cms:CHANGE_ME@127.0.0.1:5432/falah_cms
# Set to true for managed Postgres (Neon, Supabase, RDS…).
DATABASE_SSL=false

# ── Secrets ───────────────────────────────────────────────────────────
# Generate each with: openssl rand -hex 32
PAYLOAD_SECRET=
# Must match REVALIDATE_SECRET in the frontend .env
REVALIDATE_SECRET=
# Must match CMS_CONTACT_API_KEY in the frontend .env
CONTACT_API_KEY=

# ── URLs ──────────────────────────────────────────────────────────────
# https:// is enforced when NODE_ENV=production
SERVER_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ── Optional: S3-compatible media storage (R2 / S3 / Supabase) ───────
# Leave empty to store uploads on local disk (./media).
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket / CDN, e.g. https://media.example.com
# (MinIO: http://<host>:9000/<bucket>)
S3_PUBLIC_URL=
# MinIO needs path-style URLs
S3_FORCE_PATH_STYLE=false
